      const doux = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (doux || !('IntersectionObserver' in window)) {
        cibles.forEach((el) => el.classList.add('vu'));
      } else {
        const observateur = new IntersectionObserver(
          (entrees) => {
            entrees.forEach((entree) => {
              if (!entree.isIntersecting) return;
              entree.target.classList.add('vu');
              observateur.unobserve(entree.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        cibles.forEach((el) => observateur.observe(el));
      }

      const searchDialog = document.querySelector<HTMLDialogElement>('.page-search')!;
      const searchToggle = document.querySelector<HTMLButtonElement>('.search-toggle')!;
      const searchInput = document.querySelector<HTMLInputElement>('#page-query')!;
      const searchResults = document.querySelector<HTMLUListElement>('.search-results')!;
      const searchStatus = document.querySelector<HTMLElement>('.search-status')!;
      const searchable = [...document.querySelectorAll<HTMLElement>('main h1, main h2, main h3, main p, main li, main summary, main figcaption, main .spec-texte, main .constat-texte, main .constat-titre, .mentions')]
        .filter((el) => !el.closest('form'));
      const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('fr').replace(/\s+/g, ' ').trim();
      let destination: HTMLElement | null = null;
      const clearDestination = () => {
        if (!destination) return;
        destination.classList.remove('search-destination');
        if (destination.dataset.searchTabindex === 'added') {
          destination.removeAttribute('tabindex');
          delete destination.dataset.searchTabindex;
        }
        destination = null;
      };
      const search = () => {
        searchResults.replaceChildren();
        const query = normalize(searchInput.value);
        if (!query) { searchStatus.textContent = 'Saisissez un mot pour retrouver un passage.'; return; }
        const matches = searchable.filter((el) => normalize(el.textContent || '').includes(query));
        searchStatus.textContent = matches.length ? matches.length + (matches.length === 1 ? ' passage trouvé' : ' passages trouvés') : 'Aucun résultat. Essayez un autre mot.';
        matches.forEach((el) => {
          const item = document.createElement('li');
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = (el.textContent || '').replace(/\s+/g, ' ').trim();
          button.addEventListener('click', () => {
            clearDestination();
            searchDialog.close();
            el.closest('details')?.setAttribute('open', '');
            el.closest('.reveal')?.classList.add('vu');
            el.querySelectorAll('.reveal').forEach((child) => child.classList.add('vu'));
            destination = el;
            el.classList.add('search-destination');
            if (!el.hasAttribute('tabindex')) { el.tabIndex = -1; el.dataset.searchTabindex = 'added'; }
            el.focus({ preventScroll: true });
            el.scrollIntoView({ block: 'center', behavior: doux ? 'instant' : 'smooth' });
          });
          item.append(button);
          searchResults.append(item);
        });
      };
      searchToggle.addEventListener('click', () => { clearDestination(); searchDialog.showModal(); search(); searchInput.focus(); });
      document.querySelector('.search-close')!.addEventListener('click', () => searchDialog.close());
      searchInput.addEventListener('input', search);

    </script>
  </body>
</html>
